{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "avrasm2: build main.asm",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\avr\\bin\\avrasm2.exe\"",
            "args": [
                "-fI",
                "-o", "\"${workspaceFolder}\\out\\main.hex\"",
                "-l", "\"${workspaceFolder}\\out\\main.lst\"",
                "-m", "\"${workspaceFolder}\\out\\main.map\"",
                "-I", "\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\dfp\\avrasm\\inc\"",
                "\"${workspaceFolder}\\main.asm\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "avrasm2",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\): (error|warning): (.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "avrdude: flash to ATmega328PB Xplained Mini",
            "type": "shell",
            "command": "\"C:\\Users\\sgkio\\AppData\\Local\\Microsoft\\WinGet\\Packages\\AVRDudes.AVRDUDE_Microsoft.Winget.Source_8wekyb3d8bbwe\\avrdude.exe\"",
            "args": [
                "-c", "xplainedmini_isp",
                "-p", "m328pb",
                "-U", "flash:w:${workspaceFolder}\\out\\main.hex:i"
            ],
            "dependsOn": ["avrasm2: build main.asm"],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
