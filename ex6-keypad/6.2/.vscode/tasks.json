{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir: ensure out/ exists",
            "type": "shell",
            "command": "if not exist \"${workspaceFolder}\\out\" mkdir \"${workspaceFolder}\\out\"",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "avr-gcc: compile main.c",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\avr\\bin\\avr-gcc.exe\"",
            "args": [
                "-mmcu=atmega328pb",
                "-D__AVR_DEV_LIB_NAME__=m328pb",
                "-I\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\dfp\\include\"",
                "-B\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\dfp\\gcc\\dev\\atmega328pb\\avr5\"",
                "-O1",
                "-ffunction-sections",
                "-fdata-sections",
                "-fshort-enums",
                "-funsigned-char",
                "-funsigned-bitfields",
                "-Wall",
                "-Wno-error",
                "-gdwarf-3",
                "-mno-const-data-in-progmem",
                "\"${workspaceFolder}\\main.c\"",
                "-o",
                "\"${workspaceFolder}\\out\\main.elf\""
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "avr-gcc",
                "fileLocation": [
                    "absolute"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+): (warning|error): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "dependsOn": [
                "mkdir: ensure out/ exists"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "avr-objcopy: build main.hex",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\Microchip\\xc8\\v2.10\\avr\\bin\\avr-objcopy.exe\"",
            "args": [
                "-O",
                "ihex",
                "\"${workspaceFolder}\\out\\main.elf\"",
                "\"${workspaceFolder}\\out\\main.hex\""
            ],
            "dependsOn": [
                "avr-gcc: compile main.c"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "avrdude: flash to ATmega328PB Xplained Mini",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-c",
                "xplainedmini_isp",
                "-p",
                "m328pb",
                "-U",
                "flash:w:${workspaceFolder}\\out\\main.hex:i"
            ],
            "dependsOn": [
                "avr-objcopy: build main.hex"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
